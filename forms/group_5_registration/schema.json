{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Vehicle description",
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "title": "Vehicle nickname",
      "minLength": 1,
      "maxLength": 240
    },
    "model": {
      "type": "string",
      "title": "Make and model",
      "minLength": 1,
      "maxLength": 240
    },
    "kind": {
      "type": "string",
      "enum": [
        "Car",
        "Motorcycle",
        "Minibus"
      ],
      "title": "Vehicle type"
    }
  },
  "required": [
    "name",
    "model",
    "kind"
  ]
  
}
